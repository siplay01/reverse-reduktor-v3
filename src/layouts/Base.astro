---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { COMPANY, SETTINGS, url } from "../lib/site";
// Preload the Cyrillic faces used above the fold (body text and headings) so text does not re-render late.
import cyr400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-cyrillic-400-normal.woff2?url";
import cyr600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-cyrillic-600-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  crumbs?: [string, string][]; // [path, label]; the last one is the current page
  section?: string;
  image?: string; // public path for og:image
  jsonld?: object[];
  wide?: boolean;
}
const { title, description, crumbs = [], section, image, jsonld = [], wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image ?? "img/og.jpg"), Astro.site).href;
const NAV: [string, string][] = [
  ["katalog/", "Каталог"], ["oborudovanie/", "Реверс-редукторы"], ["remont/", "Ремонт"], ["dokumentaciya/", "Документация"],
  ["tendery/", "Тендеры"], ["o-kompanii/", "О компании"], ["kontakty/", "Контакты"],
];
const trail: [string, string][] = crumbs.length ? [["", "Главная"], ...crumbs] : [];
const ld = [
  ...jsonld,
  ...(trail.length
    ? [{ "@context": "https://schema.org", "@type": "BreadcrumbList",
        itemListElement: trail.map(([p, n], i) => ({ "@type": "ListItem", position: i + 1, name: n, item: new URL(url(p), Astro.site).href })) }]
    : []),
];
const fullTitle = title.includes(COMPANY.brand) ? title : `${title} | ${COMPANY.brand}`;
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<link rel="preload" href={cyr400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={cyr600} as="font" type="font/woff2" crossorigin>
<meta name="description" content={description}>
<meta name="robots" content={SETTINGS.indexable ? "index, follow" : "noindex, nofollow"}>
<link rel="canonical" href={canonical}>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#102030">
<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content={COMPANY.brand}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<link rel="sitemap" href={url("sitemap-index.xml")}>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
<a class="skip" href="#main">Перейти к содержимому</a>
<div class="topbar"><div class="wrap">
  <a href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a>
  <a class="hide-s" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
  <span class="hide-s">Барнаул · {COMPANY.hours}</span>
  <span class="demo">Демонстрационная версия сайта</span>
</div></div>
<header class="header"><div class="wrap">
  <a class="brand" href={url()} aria-label={`${COMPANY.brand}: на главную`}>
    <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="17" r="6" fill="none" stroke="#e08445" stroke-width="2"/><circle cx="23.5" cy="17" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 27h24" stroke="currentColor" stroke-width="1.5"/></svg>
    <span><b>{COMPANY.brand}</b><span>Судовые реверс-редукторы и запчасти</span></span>
  </a>
  <button class="menu-btn" type="button" aria-controls="nav" aria-expanded="false" data-menu>
    <span class="sr">Меню</span>
    <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
  <nav class="nav" id="nav" aria-label="Основное меню">
    {NAV.map(([p, label]) => <a href={url(p)} aria-current={section === p ? "page" : undefined}>{label}</a>)}
  </nav>
  <a class="rfq-link" href={url("zapros/")} aria-current={section === "zapros/" ? "page" : undefined}>
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 2h7l3 3v11H4z M11 2v3h3 M7 9h5M7 12h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    <span class="lbl">Запрос</span><span class="cnt" data-rfq-count></span><span class="sr">Список запроса</span>
  </a>
</div></header>
<main id="main" tabindex="-1">
  <slot name="before" />
  <div class={wide ? "" : "wrap page"}>
    {trail.length > 0 && (
      <nav aria-label="Навигационная цепочка"><ol class="crumbs">
        {trail.map(([p, n], i) => i < trail.length - 1 ? <li><a href={url(p)}>{n}</a></li> : <li aria-current="page">{n}</li>)}
      </ol></nav>
    )}
    <slot />
  </div>
</main>
<footer class="footer"><div class="wrap">
  <div class="cols">
    <div>
      <h2>{COMPANY.brand}</h2>
      <p>Судовые реверс-редукторы РР-300, РР-238, 3Д6, 3Д12, запасные части и ремонт.</p>
      <p>{COMPANY.operator}, ИНН {COMPANY.inn}, ОГРН {COMPANY.ogrn}</p>
    </div>
    <div>
      <h2>Каталог</h2>
      <ul>
        <li><a href={url("katalog/rr-300/")}>Запчасти РР-300</a></li>
        <li><a href={url("katalog/3d6/")}>Запчасти 3Д6</a></li>
        <li><a href={url("katalog/3d12/")}>Запчасти 3Д12</a></li>
        <li><a href={url("katalog/rr-238/")}>Запчасти РР-238</a></li>
        <li><a href={url("katalog/rr-300/uzly/")}>Узлы РР-300 по каталогу</a></li>
      </ul>
    </div>
    <div>
      <h2>Компания</h2>
      <ul>
        <li><a href={url("o-kompanii/")}>О компании</a></li>
        <li><a href={url("tendery/")}>Тендеры и госзакупки</a></li>
        <li><a href={url("dostavka-i-oplata/")}>Доставка и оплата</a></li>
        <li><a href={url("dokumentaciya/")}>Документация</a></li>
        <li><a href={url("istochniki/")}>Источники данных</a></li>
      </ul>
    </div>
    <div>
      <h2>Контакты</h2>
      <p><a href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a></p>
      <p><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
      <p>{COMPANY.address}</p>
    </div>
  </div>
  <div class="legal">Демонстрационная версия. Цены и наличие по запросу. Сайт не собирает персональные данные: запрос формируется в вашей почтовой программе. Данные каталога восстановлены из архивов, см. <a href={url("istochniki/")}>источники</a>.</div>
</div></footer>
<div id="live" class="sr" aria-live="polite"></div>
<div class="toast" data-toast hidden role="status"><span data-toast-text></span><a href={url("zapros/")}>Открыть список</a></div>
<dialog class="lightbox" data-lightbox aria-label="Просмотр изображения">
  <div class="inner"><img alt="" data-lightbox-img></div>
  <button type="button" class="btn close" data-lightbox-close>Закрыть</button>
</dialog>
<script>
  import "../scripts/app.ts";
</script>
</body>
</html>
