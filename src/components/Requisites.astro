---
import { COMPANY } from "../lib/site";
---
<dl class="facts">
  <dt>Организация</dt><dd>{COMPANY.operator}</dd>
  <dt>ИНН / КПП</dt><dd class="sku">{COMPANY.inn} / {COMPANY.kpp}</dd>
  <dt>ОГРН</dt><dd class="sku">{COMPANY.ogrn}</dd>
  <dt>Адрес</dt><dd>{COMPANY.address}</dd>
  <dt>Телефон</dt><dd><a href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a></dd>
  <dt>E-mail</dt><dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
  <dt>Режим работы</dt><dd>{COMPANY.hours}, суббота и воскресенье выходные</dd>
</dl>
