---
import Base from "../../layouts/Base.astro";
import Catalog from "../../components/Catalog.astro";
import { sortedParts, modelsInOrder, partsOf } from "../../lib/data";
import { url } from "../../lib/site";
---
<Base title="Каталог запчастей к реверс-редукторам РР-300, РР-238, 3Д6, 3Д12" section="katalog/" crumbs={[["katalog/", "Каталог"]]}
  description={`Поиск запчастей к судовым реверс-редукторам по заводскому обозначению и названию: ${sortedParts.length} позиций, фото, узлы РР-300, фильтры по модели и типу детали.`}>
  <h1>Каталог запчастей</h1>
  <p class="lead">{sortedParts.length} заводских обозначений к реверс-редукторам {modelsInOrder.map((m) => m.name).join(", ")}. Цена и наличие по запросу.</p>
  <p class="small" style="margin-bottom:24px">{modelsInOrder.map((m, i) => <>{i > 0 && ", "}<a href={url(`katalog/${m.slug}/`)}>{m.name}</a> ({partsOf(m.id).length})</>)}. Подбор по чертежам: <a href={url("katalog/rr-300/uzly/")}>узлы РР-300</a>, <a href={url("dokumentaciya/katalog-rr-300/")}>каталог РР-300 целиком</a>.</p>
  <Catalog list={sortedParts} />
</Base>
