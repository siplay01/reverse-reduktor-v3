---
import Base from "../../../../layouts/Base.astro";
import Icon from "../../../../components/Icon.astro";
import { assemblies, partById } from "../../../../lib/data";
import type { Assembly } from "../../../../lib/data";
import { url } from "../../../../lib/site";
export const getStaticPaths = () => assemblies.map((a) => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props as { a: Assembly };
const prev = assemblies.find((x) => x.figure === a.figure - 1);
const next = assemblies.find((x) => x.figure === a.figure + 1);
const multi = a.variants.length > 1;
const unit = a.designation && a.designation !== "СБ525-01-13" ? a.designation : "";
---
<Base title={`РР-300, рис. ${a.figure}. ${a.title}`} section="katalog/rr-300/uzly/"
  crumbs={[["katalog/", "Каталог"], ["katalog/rr-300/", "РР-300"], ["katalog/rr-300/uzly/", "Узлы"], [`katalog/rr-300/uzly/${a.slug}/`, `Рис. ${a.figure}`]]}
  description={`Реверс-редуктор РР-300, рис. ${a.figure}: ${a.title}. Чертёж и спецификация по заводскому каталогу: обозначения деталей, количество по исполнениям, масса.`}>
  <div class="node-head">
    <figure class="drawing">
      <a href={url(a.drawing.f.src)} data-zoom aria-label={`Открыть чертёж рис. ${a.figure} в полном размере`}>
        <img src={url(a.drawing.t.src)} width={a.drawing.t.w} height={a.drawing.t.h} alt={`Чертёж узла: рис. ${a.figure}, ${a.title}`} fetchpriority="high" />
      </a>
      <figcaption>Нажмите на чертёж, чтобы увеличить.</figcaption>
    </figure>
    <div>
      <p class="code" style="font:600 16px var(--mono);color:var(--accent);margin:0 0 8px">РР-300 · рис. {a.figure}</p>
      <h1>{a.title}</h1>
      <p class="muted">Реверс-редуктор РР-300 <span class="sku">СБ525-01-13</span>{unit && <>, узел <span class="sku">{unit}</span></>}. Позиций в спецификации: {a.rows.length}.</p>
      <div class="btns" style="margin-top:20px">
        <a class="btn ghost" href={url(a.spec.f.src)} data-zoom aria-label={`Скан спецификации рис. ${a.figure}`}><Icon name="zoom-in" size={18} />Скан спецификации</a>
        <a class="btn ghost" href={url(`katalog/?uzel=${a.figure}`)}>Детали узла с фото</a>
      </div>
      <nav class="pager" aria-label="Соседние рисунки">
        {prev && <a href={url(`katalog/rr-300/uzly/${prev.slug}/`)}><span>Рис. {prev.figure}</span>{prev.title}</a>}
        {next && <a class="next" href={url(`katalog/rr-300/uzly/${next.slug}/`)}><span>Рис. {next.figure}</span>{next.title}</a>}
      </nav>
    </div>
  </div>

  <section class="sec" aria-labelledby="h-spec">
    <div class="sec-head"><h2 id="h-spec">Спецификация</h2>{multi && <a class="textlink" href={url("oborudovanie/rr-300/#ispolneniya")}>Что означают исполнения <Icon name="arrow-right" size={16} /></a>}</div>
    <div class="tbl-wrap" tabindex="0" role="region" aria-label={`Спецификация рис. ${a.figure}`}>
      <table class="tbl">
        <caption class="sr">Спецификация к рис. {a.figure}. {a.title}</caption>
        <thead>
          {multi && <tr class="grp"><th colspan="3"></th><th colspan={a.variants.length} class="q">Количество на исполнение</th><th colspan="3"></th></tr>}
          <tr>
            <th scope="col" class="pos">Поз.</th><th scope="col">Обозначение</th><th scope="col">Наименование</th>
            {a.variants.map((v) => <th scope="col" class="q"><span class="sku">{multi ? v : "Кол."}</span></th>)}
            <th scope="col" class="q">Масса, кг</th><th scope="col">Материал</th>
            <th scope="col"><span class="sr">Действие</span></th>
          </tr>
        </thead>
        <tbody>
          {a.rows.map((r) => {
            const p = r.part ? partById.get(r.part) : undefined;
            const id = p ? p.id : `node${a.figure}-${r.pos}`;
            return (
              <tr id={`poz-${r.pos}`}>
                <td class="pos">{r.pos}</td>
                <td class="des">{p ? <a class="sku" href={url(`katalog/detal/${p.id}/`)}>{r.designation}</a> : <span class="sku">{r.designation}</span>}{r.note && <sup>{r.note}</sup>}</td>
                <td>{r.name}</td>
                {(r.qty ?? a.variants.map(() => null)).map((q) => <td class={q == null ? "q none" : "q"}>{q ?? "–"}</td>)}
                <td class="q">{r.mass ?? ""}</td><td>{r.material ?? ""}</td>
                <td><button type="button" class="btn ghost sm" data-rfq-add data-id={id} data-d={r.designation === "БЧ" ? r.name : r.designation} data-n={r.designation === "БЧ" ? `РР-300, рис. ${a.figure}, поз. ${r.pos}` : r.name}
                  data-img={p?.photos[0] ? url(p.photos[0].t.src) : ""} data-href={p ? url(`katalog/detal/${p.id}/`) : url(`katalog/rr-300/uzly/${a.slug}/#poz-${r.pos}`)} aria-pressed="false">В запрос</button></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {Object.entries(a.footnotes).map(([k, v]) => <p class="fn"><sup>{k}</sup> {v}</p>)}
  </section>
</Base>
