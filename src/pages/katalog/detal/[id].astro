---
import Base from "../../../layouts/Base.astro";
import Gallery from "../../../components/Gallery.astro";
import PartCard from "../../../components/PartCard.astro";
import Icon from "../../../components/Icon.astro";
import { parts, partById, modelById, asmByFigure, modelNames, manual } from "../../../lib/data";
import type { Part } from "../../../lib/data";
import { COMPANY, url, rub } from "../../../lib/site";

export const getStaticPaths = () => parts.map((p) => ({ params: { id: p.id }, props: { p } }));
const { p } = Astro.props as { p: Part };
const ms = p.models.map((i) => modelById.get(i)!);
const mn = modelNames(p.models).join(", ");
const main = ms[0];
// Related = other parts of the same assembly drawing (relation stated by the factory catalog).
const related: Part[] = [];
for (const x of p.assemblies) {
  for (const r of asmByFigure.get(x.figure)?.rows ?? []) {
    const q = r.part ? partById.get(r.part) : undefined;
    if (q && q.id !== p.id && !related.includes(q) && related.length < 10) related.push(q);
  }
}
const altSpell = p.spellings.filter((s) => s !== p.designation && s.replace(/\s/g, "") !== p.designation);
const hasManual = p.models.some((m) => manual.models.includes(m));
const ld = {
  "@context": "https://schema.org", "@type": "Product", name: `${p.designation} ${p.name}`, sku: p.designation, mpn: p.designation,
  category: `Запчасти для реверс-редуктора ${mn}`, ...(p.photos[0] ? { image: new URL(url(p.photos[0].f.src), Astro.site).href } : {}),
  ...(p.description.length ? { description: p.description.join(" ") } : {}),
};
---
<Base title={`${p.designation} ${p.name}: запчасть для реверс-редуктора ${mn}`} section="katalog/"
  crumbs={[["katalog/", "Каталог"], [`katalog/${main.slug}/`, main.name], [`katalog/detal/${p.id}/`, p.designation]]}
  description={`${p.designation} ${p.name}, запчасть для судового реверс-редуктора ${mn}.${p.assemblies.length ? ` РР-300, рис. ${p.assemblies.map((a) => a.figure).join(", ")}.` : ""} Фото, применение, запрос стоимости и наличия.`}
  image={p.photos[0]?.f.src} jsonld={[ld]}>
  <div class="prod">
    <Gallery photos={p.photos} alt={`${p.designation} ${p.name}`} code={p.designation} />
    <div>
      <p class="code">{p.designation}</p>
      <h1>{p.name}</h1>
      <p class="for">Запчасть для реверс-редуктора {ms.map((m, i) => <>{i > 0 && ", "}<a href={url(`oborudovanie/${m.slug}/`)}>{m.name}</a></>)}</p>
      <div class="buy">
        <p class="price big" class:list={[{ none: !p.price }]}>{rub(p.price)}</p>
        <div class="row">
          <div class="field">
            <label for="qty">Количество, шт.</label>
            <div class="qty"><button type="button" data-step="-1" aria-label="Уменьшить количество"><Icon name="minus" size={18} /></button><input id="qty" type="number" inputmode="numeric" min="1" max="9999" value="1"><button type="button" data-step="1" aria-label="Увеличить количество"><Icon name="plus" size={18} /></button></div>
          </div>
          <button type="button" class="btn" data-rfq-add data-qty="#qty" data-id={p.id} data-d={p.designation} data-n={p.name}
            data-img={p.photos[0] ? url(p.photos[0].t.src) : ""} data-href={url(`katalog/detal/${p.id}/`)}>Добавить в запрос</button>
        </div>
        <p class="status" data-in-list={p.id} hidden><b data-in-list-text></b> <a href={url("zapros/")}>Открыть список</a></p>
        <p class="status muted">Наличие и срок поставки по запросу: <a href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a>, <a href={`mailto:${COMPANY.email}?subject=${encodeURIComponent(`Запрос: ${p.designation}`)}`}>{COMPANY.email}</a></p>
      </div>
      <dl class="facts">
        <dt>Обозначение</dt><dd><span class="sku">{p.designation}</span>{altSpell.length > 0 && <span class="muted small"> (также {altSpell.join(", ")})</span>}</dd>
        <dt>Наименование</dt><dd>{p.name}</dd>
        <dt>Реверс-редуктор</dt><dd>{ms.map((m) => `${m.name} ${m.designation}`).join(", ")}</dd>
        {p.assemblies.length > 0 && <><dt>Узел</dt><dd>{p.assemblies.map((x, i) => {
          const a = asmByFigure.get(x.figure)!;
          return <>{i > 0 && <br />}<a href={url(`katalog/rr-300/uzly/${a.slug}/#poz-${x.pos}`)}>рис. {a.figure}, поз. {x.pos}</a> <span class="muted">{a.title}</span></>;
        })}</dd></>}
        <dt>Тип</dt><dd>{p.type}</dd>
      </dl>
      {p.description.length > 0 && <div style="margin-top:20px">{p.description.map((l) => <p>{l}</p>)}</div>}
    </div>
  </div>

  {related.length > 0 && (
    <section class="sec" aria-labelledby="h-rel">
      <div class="sec-head"><h2 id="h-rel">Детали того же узла</h2><a class="textlink" href={url(`katalog/rr-300/uzly/${asmByFigure.get(p.assemblies[0].figure)!.slug}/`)}>Чертёж и спецификация <Icon name="arrow-right" size={16} /></a></div>
      <div class="strip">{related.map((q, i) => <PartCard p={q} order={i} />)}</div>
    </section>
  )}

  {hasManual && (
    <section class="sec" aria-labelledby="h-docs">
      <div class="sec-head"><h2 id="h-docs">Документация</h2></div>
      <div class="btns">
        <a class="btn ghost" href={url(manual.href)} target="_blank" rel="noopener"><Icon name="file-type-pdf" size={18} />Руководство по эксплуатации, PDF</a>
        {p.models.includes("rr300") && <a class="btn ghost" href={url("dokumentaciya/katalog-rr-300/")}><Icon name="book" size={18} />Каталог деталей РР-300</a>}
      </div>
    </section>
  )}
</Base>
